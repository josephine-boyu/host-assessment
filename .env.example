# 僅放不敏感、跨腳本共用的執行參數。
# 複製為 .env 後依本機需求調整；.env 不會被 Git 追蹤。
REPORT_DIR=reports
SSH_CONNECT_TIMEOUT=8
SSH_PORT=22
# AWS SDK 使用本機 credential chain；此處只放 profile 名稱，不放 access key。
# AWS_PROFILE=your-readonly-profile
DAILY_HISTORY_DAYS=14
# 僅在執行環境的 ~/.ssh/config 不是實際設定檔時使用；不是密鑰內容。
# SSH_CONFIG=C:/Users/your-name/.ssh/config
# SSH_COMMAND=C:/Program Files/Git/usr/bin/ssh.exe
